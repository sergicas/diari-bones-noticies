{
  "name": "diari-bones-noticies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "check:articles": "node scripts/check-articles.mjs",
