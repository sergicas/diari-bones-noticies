{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bondiari",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // El Worker s'executa primer per a TOTES les peticions perquè el wrapper
    // withSecurityHeaders pugui afegir CSP i la resta de capçaleres de
    // seguretat també a les respostes HTML/estàtiques (no només a /api/*).
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Model que reescriu les peces en català. Fins al 13-08-2026 feia servir
    // el més petit de Google (flash-lite) i no arribava: se li demanaven de 80
    // a 150 paraules i entregava menys de 45, així que TOTES les peces queien
    // a la barrera de qualitat i no arribava res a la sala de revisió.
    // Es pot tornar enrere canviant només aquesta línia.
    "GEMINI_MODEL": "gemini-flash-latest"
  },
  "kv_namespaces": [
    { "binding": "LIVE_NEWS_KV", "id": "8dccac0ffa434f75b13ba6a7890646af" },
    { "binding": "STATS_KV", "id": "08a529af25eb41eca09d26276cba77d2" }
  ],
  "d1_databases": [
    {
      "binding": "EDITORIAL_DB",
      "database_name": "bondiari-editorial",
      "database_id": "b2776783-5d4e-483f-b609-c67e641671f9",
      "migrations_dir": "./migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "bondiari-ingest" },
      { "binding": "DISTRIBUTION_QUEUE", "queue": "bondiari-distribute" }
    ],
    "consumers": [
      {
        "queue": "bondiari-ingest",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "bondiari-ingest-dlq",
        "retry_delay": 30
      },
      {
        "queue": "bondiari-distribute",
        "max_batch_size": 2,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "bondiari-distribute-dlq",
        "retry_delay": 60
      }
    ]
  },
  // Workers AI: segona capa del filtre editorial (jutja les notícies neutres).
  "ai": { "binding": "AI" },
  "triggers": {
    // Portada principal: es renova cada 12h.
    // 0 5 * * *  → edició de matí a les 07:00 CEST. Aquest cron també és el del
    //             butlletí DIARI (refresca el radar i envia el correu del dia).
    // 0 17 * * * → edició de tarda a les 19:00 CEST (només refresca el radar).
    // La secció "En directe" (/api/live-ticker) es refresca a part, a demanda,
    // amb una cache curta; no depèn d'aquests crons.
    "crons": ["0 5 * * *", "0 17 * * *"]
  },
  "env": {
    // Staging té dades i cues pròpies, i deliberadament no té cap cron.
    "staging": {
      "name": "bondiari-staging",
      "triggers": {
        "crons": []
      },
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "kv_namespaces": [
        { "binding": "LIVE_NEWS_KV", "id": "3763eba40f604b528c8c968ba2280131" },
        { "binding": "STATS_KV", "id": "6d3084f174a249d4b2dcf9686e8f98de" }
      ],
      "d1_databases": [
        {
          "binding": "EDITORIAL_DB",
          "database_name": "bondiari-editorial-staging",
          "database_id": "8433faec-5027-4ccc-8a65-1f2de89e3748",
          "migrations_dir": "./migrations"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "bondiari-ingest-staging" },
          { "binding": "DISTRIBUTION_QUEUE", "queue": "bondiari-distribute-staging" }
        ],
        "consumers": [
          {
            "queue": "bondiari-ingest-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "bondiari-ingest-staging-dlq",
            "retry_delay": 30
          },
          {
            "queue": "bondiari-distribute-staging",
            "max_batch_size": 2,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "bondiari-distribute-staging-dlq",
            "retry_delay": 60
          }
        ]
      },
      "ai": { "binding": "AI" }
    }
  }
}
