{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bondiari",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // El Worker s'executa primer per a TOTES les peticions perquè el wrapper
    // withSecurityHeaders pugui afegir CSP i la resta de capçaleres de
    // seguretat també a les respostes HTML/estàtiques (no només a /api/*).
    "run_worker_first": true
  },
  // EL DOMINI PROPI, DECLARAT AL FITXER (15-08-2026).
  //
  // Estava configurat només al tauler de Cloudflare, i el dia que va deixar de
  // servir no hi havia manera de veure-ho ni de restaurar-ho des del codi.
  // Declarat aquí, cada desplegament torna a lligar les rutes i queda escrit
  // qui ha de respondre a bondiari.com.
  //
  // No es fan servir Custom Domains de Workers: el 15-08-2026 el rang IP que
  // aquests registres assignaven era inaccessible des de Telefónica. Els
  // CNAME DNS-only cap a workers.dev i aquestes rutes donen el mateix servei,
  // però eviten aquella assignació de xarxa.
  // Declarar rutes desactiva l'adreça workers.dev per defecte, i aquesta és
  // la que fan servir els scripts (refresc, comprovacions) i l'única que va
  // seguir funcionant el dia que bondiari.com va caure. Es manté explícitament.
  "workers_dev": true,
  "routes": [
    { "pattern": "bondiari.com/*", "zone_name": "bondiari.com" },
    { "pattern": "www.bondiari.com/*", "zone_name": "bondiari.com" }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Model que reescriu les peces en català. Fins al 13-08-2026 feia servir
    // el més petit de Google (flash-lite) i no arribava: se li demanaven de 80
    // a 150 paraules i entregava menys de 45, així que TOTES les peces queien
    // a la barrera de qualitat i no arribava res a la sala de revisió.
    // Es pot tornar enrere canviant només aquesta línia.
    "GEMINI_MODEL": "gemini-flash-latest",
    // L'AJUDANT DE REDACCIÓ: off | shadow | auto.
    //
    // Comença en OMBRA: pensa, deixa escrit què hauria fet, i no toca res.
    // Així es pot comparar el seu criteri amb el de Sergi durant uns dies
    // abans de deixar-lo publicar. Es passa a "auto" canviant aquesta línia.
    "ASSISTANT_MODE": "shadow"
  },
  "kv_namespaces": [
    { "binding": "LIVE_NEWS_KV", "id": "8dccac0ffa434f75b13ba6a7890646af" },
    { "binding": "STATS_KV", "id": "08a529af25eb41eca09d26276cba77d2" }
  ],
  "d1_databases": [
    {
      "binding": "EDITORIAL_DB",
      "database_name": "bondiari-editorial",
      "database_id": "b2776783-5d4e-483f-b609-c67e641671f9",
      "migrations_dir": "./migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "bondiari-ingest" },
      { "binding": "DISTRIBUTION_QUEUE", "queue": "bondiari-distribute" }
    ],
    "consumers": [
      {
        "queue": "bondiari-ingest",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "bondiari-ingest-dlq",
        "retry_delay": 30,
        // UN SOL CONSUMIDOR (14-08-2026). Per defecte, Cloudflare escala els
        // consumidors en paral·lel. Dues execucions del radar alhora es
        // trepitgen el lot públic, perquè KV no té operacions atòmiques de
        // llegir-modificar-escriure. Amb el radar com a únic escriptor, la
        // manera de garantir un sol escriptor és serialitzar la cua.
        "max_concurrency": 1
      },
      {
        "queue": "bondiari-distribute",
        "max_batch_size": 2,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "bondiari-distribute-dlq",
        "retry_delay": 60
      }
    ]
  },
  // Workers AI: segona capa del filtre editorial (jutja les notícies neutres).
  "ai": { "binding": "AI" },
  "triggers": {
    // Portada principal: es renova cada 12h.
    // 0 5 * * *  → edició de matí a les 07:00 CEST. Aquest cron també és el del
    //             butlletí DIARI (refresca el radar i envia el correu del dia).
    // 0 17 * * * → edició de tarda a les 19:00 CEST (només refresca el radar).
    // La secció "En directe" (/api/live-ticker) es refresca a part, a demanda,
    // amb una cache curta; no depèn d'aquests crons.
    "crons": ["0 5 * * *", "0 17 * * *"]
  },
  "env": {
    // Staging té dades i cues pròpies, i deliberadament no té cap cron.
    "staging": {
      "name": "bondiari-staging",
      // Les rutes de producció s'hereten si no es buiden explícitament. Sense
      // això un desplegament de staging podria desviar el domini públic.
      "routes": [],
      "triggers": {
        "crons": []
      },
      "vars": {
        "ENVIRONMENT": "staging",
        // Les vars d'entorn de Wrangler NO s'hereten: sense declarar-lo aquí,
        // staging cauria al valor per defecte del codi (flash-lite) i no
        // reproduiria el comportament de producció.
        "GEMINI_MODEL": "gemini-flash-latest",
        "ASSISTANT_MODE": "shadow"
      },
      "kv_namespaces": [
        { "binding": "LIVE_NEWS_KV", "id": "3763eba40f604b528c8c968ba2280131" },
        { "binding": "STATS_KV", "id": "6d3084f174a249d4b2dcf9686e8f98de" }
      ],
      "d1_databases": [
        {
          "binding": "EDITORIAL_DB",
          "database_name": "bondiari-editorial-staging",
          "database_id": "8433faec-5027-4ccc-8a65-1f2de89e3748",
          "migrations_dir": "./migrations"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "bondiari-ingest-staging" },
          { "binding": "DISTRIBUTION_QUEUE", "queue": "bondiari-distribute-staging" }
        ],
        "consumers": [
          {
            "queue": "bondiari-ingest-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "bondiari-ingest-staging-dlq",
            "retry_delay": 30,
            // Igual que a producció: les configuracions d'entorn de Wrangler NO
            // s'hereten, així que sense aquesta línia staging es quedava amb
            // consumidors concurrents i no reproduïa el comportament real.
            "max_concurrency": 1
          },
          {
            "queue": "bondiari-distribute-staging",
            "max_batch_size": 2,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "bondiari-distribute-staging-dlq",
            "retry_delay": 60
          }
        ]
      },
      "ai": { "binding": "AI" }
    }
  }
}
