{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bondiari",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // El Worker s'executa primer per a TOTES les peticions perquè el wrapper
    // withSecurityHeaders pugui afegir CSP i la resta de capçaleres de
    // seguretat també a les respostes HTML/estàtiques (no només a /api/*).
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "LIVE_NEWS_KV", "id": "8dccac0ffa434f75b13ba6a7890646af" },
    { "binding": "STATS_KV", "id": "08a529af25eb41eca09d26276cba77d2" }
  ],
  "triggers": {
    // 0 */4 * * * → refresc del radar cada 4h (02, 06, 10, 14, 18, 22 CEST)
    // 0 6 * * *   → refresc matinal extra (08:00 CEST), per agafar les
    //              actualitzacions de l'edició diària de redaccions catalanes.
    // 0 5 * * *   → butlletí DIARI: cada matí a les 07:00 CEST (refresca el
    //              radar i envia el correu amb les bones notícies del dia).
    "crons": ["0 */4 * * *", "0 6 * * *", "0 5 * * *"]
  }
}
